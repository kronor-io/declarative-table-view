{
    "name": "@kronor/dtv-analytics",
    "version": "0.1.0",
    "description": "Shows how an app's DTV tables are used, from the events DTV reports and users' stored DTV data.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kronor-io/declarative-table-view.git",
        "directory": "packages/dtv-analytics"
    },
    "type": "module",
    "bin": {
        "dtv-analytics": "bin/dtv-analytics.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "bin",
        "dist",
        "docker",
        "docs",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && npm run build:sidecar && npm run build:app",
        "build:sidecar": "esbuild src/sidecar/main.ts --bundle --platform=node --format=esm --loader:.css=empty --outfile=dist/sidecar.mjs",
        "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
        "test-unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
        "build:app": "vite build --config app/vite.config.ts",
        "dev:app": "vite --config app/vite.config.ts",
        "typegen": "dtv typegen",
        "build:image": "npm run build && docker build -f docker/Dockerfile -t dtv-analytics-server:dev ."
    },
    "dependencies": {
        "esbuild": "^0.25.4",
        "fast-glob": "^3.3.3"
    },
    "devDependencies": {
        "@kronor/dtv": "*",
        "@vitejs/plugin-react": "^4.3.4",
        "echarts": "5.6.0",
        "primereact": "^10.9.7",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite": "^6.0.0"
    }
}
