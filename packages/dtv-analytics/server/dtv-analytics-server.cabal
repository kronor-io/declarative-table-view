cabal-version: 3.0
name:          dtv-analytics-server
version:       0.1.0
synopsis:      Fetches the analytics events and user data of DTV tables into a local store
build-type:    Simple

common shared
  default-language: GHC2021
  default-extensions:
    BlockArguments
    DataKinds
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
  ghc-options:      -Wall -Wno-name-shadowing

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    DtvAnalytics.Api
    DtvAnalytics.Config
    DtvAnalytics.Derive
    DtvAnalytics.Event
    DtvAnalytics.Fetch
    DtvAnalytics.GraphQL
    DtvAnalytics.Hasura
    DtvAnalytics.Sidecar
    DtvAnalytics.Source
    DtvAnalytics.Store
  build-depends:
      base              >=4.18 && <5
    , aeson             >=2.1 && <2.3
    , async             >=2.2 && <2.3
    , bytestring        >=0.11 && <0.13
    , case-insensitive  >=1.2 && <1.3
    , containers        >=0.6 && <0.8
    , directory         >=1.3 && <1.4
    , filepath          >=1.4 && <1.6
    , hasql             >=1.10 && <1.11
    , hasql-pool        >=1.4 && <1.5
    , http-client       >=0.7 && <0.8
    , http-client-tls   >=0.3 && <0.4
    , http-types        >=0.12 && <0.13
    , servant           >=0.20 && <0.21
    , servant-server    >=0.20 && <0.21
    , stm               >=2.5 && <2.6
    , streaming         >=0.2 && <0.3
    , text              >=2.0 && <2.2
    , time              >=1.12 && <1.15
    , typed-process     >=0.2 && <0.3
    , uuid-types        >=1.0 && <1.1
    , vector            >=0.13 && <0.14
    , wai               >=3.2 && <3.3
    , wai-app-static    >=3.1 && <3.2
    , warp              >=3.3 && <3.5

executable dtv-analytics-server
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base
    , async
    , warp
    , dtv-analytics-server

test-suite spec
  import:          shared
  type:            exitcode-stdio-1.0
  build-tool-depends: hspec-discover:hspec-discover
  hs-source-dirs:  test
  main-is:         Spec.hs
  other-modules:
    DtvAnalytics.EventSpec
    DtvAnalytics.GraphQLSpec
  build-depends:
      base
    , dtv-analytics-server
    , aeson
    , containers
    , hspec >=2.10 && <2.12
    , text
    , time
