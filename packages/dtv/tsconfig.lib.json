{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": false,
        "emitDeclarationOnly": true,
        "rootDir": "src",
        "outDir": "dist/types",
        "noEmit": false,
        "stripInternal": true
    },
    "include": [
        "src/vite-env.d.ts",
        "src/lib/index.ts",
        "src/typegen/index.ts"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/__mocks__/**"
    ]
}
