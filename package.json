{
    "name": "kronor-dtv-monorepo",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/hasura-graphql",
        "packages/dtv",
        "packages/dtv-analytics"
    ],
    "engines": {
        "node": ">=22 <24"
    },
    "scripts": {
        "build": "npm run build --workspace @kronor/hasura-graphql && npm run build --workspace @kronor/dtv",
        "build:lib": "npm run build:lib --workspace @kronor/dtv",
        "clean": "npm run clean --workspaces --if-present",
        "lint": "eslint .",
        "test-unit:all": "npm run test-unit --workspaces --if-present && npm run test-unit:cli --workspaces --if-present",
        "test": "npm run test --workspace @kronor/dtv",
        "dev": "npm run dev --workspace @kronor/dtv",
        "prepare": "husky",
        "test-unit": "npm run test-unit --workspaces --if-present",
        "release": "node scripts/release.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "rimraf": "^6.1.4",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.2"
    }
}
